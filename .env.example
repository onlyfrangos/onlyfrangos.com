# Database
POSTGRES_DB=onlyfrangos
POSTGRES_USER=onlyfrangos
POSTGRES_PASSWORD=onlyfrangos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://onlyfrangos:onlyfrangos@localhost:5432/onlyfrangos?schema=public

# Redis (future-ready)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
JWT_ACCESS_TOKEN_SECRET=change-me-access
JWT_REFRESH_TOKEN_SECRET=change-me-refresh
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
API_PUBLIC_URL=http://localhost:3001

# Cloudflare R2 (obrigatório em produção para uploads de avatar)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
